{
  "name": "ai-qa-agent",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered autonomous software testing and production-readiness platform",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run tests/unit",
    "test:rules": "vitest run tests/integration/firestore-rules tests/integration/storage-rules"
  },
  "devDependencies": {
    "@ai-qa-agent/agent-core": "workspace:*",
    "@ai-qa-agent/ai": "workspace:*",
    "@ai-qa-agent/api-tester": "workspace:*",
    "@ai-qa-agent/browser-agent": "workspace:*",
    "@ai-qa-agent/code-analyzer": "workspace:*",
    "@ai-qa-agent/command-policy": "workspace:*",
    "@ai-qa-agent/project-analyzer": "workspace:*",
    "@ai-qa-agent/qa-engine": "workspace:*",
    "@ai-qa-agent/security-engine": "workspace:*",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0",
    "firebase-tools": "^13.35.1",
    "vitest": "^4.1.11"
  }
}

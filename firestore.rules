rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function ownsProject(projectId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // Per-user profile document.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // GitHub OAuth token — server (Admin SDK) only, same pattern as
      // projects/{id}/private above.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    match /projects/{projectId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);

      // Secrets (AI provider keys, etc.) — server (Admin SDK) only. Admin SDK
      // bypasses these rules entirely, so this explicitly blocks all client access.
      match /private/{document=**} {
        allow read, write: if false;
      }

      // Run history, findings, generated tests, agent messages, command audit
      // log, and GitHub connection metadata — readable/writable only by the
      // project owner, and only ever created by the server/local agent path.
      match /runs/{runId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
      match /findings/{findingId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
      match /tests/{testId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
      match /messages/{messageId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
      match /commands/{commandId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
      match /github/{connectionId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
      // Readiness-score snapshots, one per real report generation — written
      // only by the server (Admin SDK) when GET /report actually computes a
      // report, never by the client, so the trend can't be gamed.
      match /reportSnapshots/{snapshotId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
